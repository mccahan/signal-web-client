# --- signal-cli-rest-api ----------------------------------------------------
# Where your signal-cli-rest-api instance is reachable.
SIGNAL_API_URL=http://10.0.1.197:8095

# Which linked account to drive. Leave blank to auto-detect the first one.
SIGNAL_NUMBER=

# --- this app ---------------------------------------------------------------
PORT=8080
DATA_DIR=./data

# Shared password for the web UI. Blank = no auth (only safe on a trusted LAN).
# This app can read and send every message on the account, so set one.
AUTH_PASSWORD=

# Set true when serving over HTTPS so the session cookie is marked Secure.
SECURE_COOKIE=false

# Sessions survive restarts automatically; set this only to share one secret
# across multiple replicas.
SESSION_SECRET=
SESSION_DAYS=30

# --- behaviour --------------------------------------------------------------
# Send read receipts when you open a conversation.
SEND_READ_RECEIPTS=true
# Broadcast your typing state.
SEND_TYPING_INDICATORS=true

# --- polling (ignored when the API server runs in json-rpc mode) ------------
# Seconds to hold each receive open while someone has the UI open.
RECEIVE_TIMEOUT=1
# Longer window when nobody is connected.
IDLE_RECEIVE_TIMEOUT=5
# Pause between idle receive cycles, in ms.
IDLE_POLL_GAP_MS=5000

MAX_UPLOAD_BYTES=104857600

# --- outbound rate limit ----------------------------------------------------
# A backstop against a runaway client or a stuck retry loop turning your Signal
# account into something Signal treats as a spam source. Shared by every
# signed-in browser, because they all drive the one account. Covers messages,
# reactions and remote deletes; typing indicators and read receipts are exempt.
# Set the rate to 0 to disable.
SEND_RATE_PER_MINUTE=30
SEND_BURST=15

LOG_LEVEL=info

# --- backups ----------------------------------------------------------------
# Periodic consistent snapshots, so an external backup job never has to copy
# the live WAL-mode database. Point your backup tool at <DATA_DIR>/backups.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=7
# BACKUP_DIR=/data/backups

# How long a browser login stays valid, and how long an unused one is kept.
SESSION_DAYS=30
SESSION_IDLE_DAYS=14
